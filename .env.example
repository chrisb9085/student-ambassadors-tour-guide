# Copy this file to .env.local and fill in your own value. Never commit .env.local.
# Public Mapbox access token (starts with "pk."). Restrict it by URL in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN_BACKUP=

# Edit mode (server-only; only `vercel dev` reads these locally). NEVER prefix them with VITE_, or Vite would ship
# them to every visitor. On Vercel, set them for Production only. See docs/ADMIN-HANDOVER.md.
# EDITOR_PASSWORD=
# GITHUB_TOKEN=
# GITHUB_BRANCH=a-test-branch
